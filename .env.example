# ─── Knight Bot Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Telegram Bot Token ────────────────────────────────────────────────────────
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot and follow the instructions
# 3. Copy the token you receive and paste it here
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ─── Optional: WhatsApp Owner Number ──────────────────────────────────────────
# Your WhatsApp number (international format, no + or spaces)
# Example: 2348012345678 for Nigeria, 447911123456 for UK
# This is also set in settings.js — either location works
# OWNER_NUMBER=2348012345678
